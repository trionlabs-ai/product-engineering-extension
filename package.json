{
  "name": "product-studio",
  "displayName": "Product Studio",
  "description": "Simplified IDE experience for Product Engineers: work on Jira tickets with AI, test, review and submit merge requests.",
  "version": "1.9.5",
  "publisher": "product-engineering",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/fersiguenza/product-engineering-extension.git"
  },
  "homepage": "https://github.com/fersiguenza/product-engineering-extension#readme",
  "bugs": {
    "url": "https://github.com/fersiguenza/product-engineering-extension/issues"
  },
  "keywords": [
    "product-engineer",
    "vibecoding",
    "jira",
    "gitlab",
    "github",
    "figma",
    "no-code",
    "ai-coding",
    "product-management"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/syntax-check.js",
    "compile": "node scripts/syntax-check.js",
    "check": "node scripts/syntax-check.js",
    "lint": "eslint . && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test --test-reporter spec test/unit/*.test.js",
    "test:smoke": "node test/run-vscode-test.js",
    "test": "npm run test:unit && npm run test:smoke",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish:vscode": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "productStudio.open",
        "title": "Product Studio: Open"
      },
      {
        "command": "productStudio.resetOnboarding",
        "title": "Product Studio: Reset Onboarding"
      },
      {
        "command": "productStudio.createTask",
        "title": "Product Studio: Create Task"
      }
    ],
    "configuration": {
      "title": "Product Studio",
      "properties": {
        "productStudio.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "default": "auto",
          "description": "Language for the Product Studio UI. 'auto' detects from VS Code."
        },
        "productStudio.ai.provider": {
          "type": "string",
          "enum": [
            "Claude",
            "GitHub Copilot",
            "Antigravity",
            "Continue",
            "Ollama",
            "ChatGPT"
          ],
          "default": "Claude",
          "description": "Default AI assistant to connect and sync ticket prompts with."
        },
        "productStudio.jira.domain": {
          "type": "string",
          "default": "",
          "description": "Jira Cloud domain (e.g. your-company.atlassian.net)"
        },
        "productStudio.git.provider": {
          "type": "string",
          "enum": [
            "gitlab",
            "github"
          ],
          "default": "gitlab"
        },
        "productStudio.git.repository": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1"
  }
}
